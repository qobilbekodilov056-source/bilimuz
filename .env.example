# Copy to .dev.vars; no fake login or test-mode bypass exists.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8787
REGISTRATION_OPEN=false
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Independent 32-byte base64 keys; keep offline recovery copies.
MFA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Random 32-byte password pepper; never store with D1 backups.
PASSWORD_PEPPER=
