{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sysone-testlab-local",
  "main": "apps/api/index.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sysone-testlab-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sysone-testlab-local"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "REGISTRATION_OPEN": "false"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 2 * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "sysone-testlab-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://bilimuz.dpdns.org",
        "REGISTRATION_OPEN": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sysone-testlab-staging",
          "database_id": "19e9b4ec-d90e-48c3-86c3-7acfadcca8ee",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "sysone-testlab-staging"
        }
      ],
      "routes": [
        {
          "pattern": "bilimuz.dpdns.org",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "sysone-testlab",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://REPLACE_INDEPENDENT_DOMAIN",
        "REGISTRATION_OPEN": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sysone-testlab-production",
          "database_id": "REPLACE_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "sysone-testlab-production"
        }
      ]
    }
  }
}
